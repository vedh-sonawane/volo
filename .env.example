# ─────────────────────────────────────────────────────────────────────────────
# Volo — environment configuration
#
# EVERYTHING HERE IS OPTIONAL. Volo runs fully at zero cost with NO keys set.
# With nothing configured, Volo uses its built-in rule-based model provider and
# the free DuckDuckGo research provider. No credit card, no paid API, ever.
# ─────────────────────────────────────────────────────────────────────────────

# ── Model provider ───────────────────────────────────────────────────────────
# Which model provider the engine should try first.
#   rule   -> built-in deterministic provider (default, zero dependencies)
#   ollama -> local open-source models via Ollama (https://ollama.com) — free
MODEL_PROVIDER=rule

# Ollama connection (only used when MODEL_PROVIDER=ollama).
# IMPORTANT: OLLAMA_MODEL must be a model you have actually pulled. Check with
# `ollama list`. If it isn't installed, Volo detects that and transparently uses
# the deterministic engine instead (it will NOT pretend the model ran).
# Install Ollama locally and run e.g.  `ollama pull llama3.2`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Max time to wait for a model response. Cold-loading a model on CPU can take
# 60-100s; a warm model answers in a few seconds. On timeout, Volo falls back to
# the deterministic summary (honestly). Raise this if your machine is slow.
OLLAMA_TIMEOUT_MS=90000

# Separate (usually longer) budget for the PLANNING call, where the model authors
# the execution plan. On a slow CPU an 8B model can take 1-2 minutes. On timeout,
# Volo falls back to the deterministic planner. Use a small/fast model or a GPU
# for snappy AI planning.
OLLAMA_PLAN_TIMEOUT_MS=240000

# ── Research provider ────────────────────────────────────────────────────────
# Which research/search backend to use.
#   duckduckgo -> free DuckDuckGo HTML endpoint (default, no key required)
RESEARCH_PROVIDER=duckduckgo

# Max pages the research engine will fetch per task (keeps runs polite + fast).
RESEARCH_MAX_FETCHES=6

# ── Real email sending (OPTIONAL, Phase 10) ──────────────────────────────────
# Volo can SEND an approved enquiry using YOUR OWN free email account (e.g. a
# Gmail account with an app password, or any free SMTP). Volo never uses a paid
# service and never bundles credentials — this relays through an account you
# already own. Leave blank to keep the honest default: Volo prepares a draft
# (.eml) for you to send yourself, and never sends silently.
#   Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Real actions (Phase 10) ──────────────────────────────────────────────────
# How consequential actions (send_email, calendar_event, book, submit_form,
# payment) are executed. All go through the SAME approval → validate → execute →
# verify pipeline; only the external side effect differs.
#   (unset)  -> production: real where a secure integration exists (SMTP send,
#              local .ics). Booking/form/payment report "unsupported" honestly
#              with safe fallback steps — Volo never fakes a booking or charge.
#   sandbox  -> routes booking/form/payment through a DETERMINISTIC test provider
#              that returns realistic success/failure/timeout/auth outcomes with
#              fake confirmations (NO real money). For safely testing the full
#              execution path end to end. Never charges real money.
ACTION_MODE=

# NOTE ON MONEY & CREDENTIALS: Volo never stores raw card numbers, CVVs, bank
# passwords, or one-time codes anywhere (DB, logs, prompts, model context). Real
# payments require a secure tokenized provider integration (not included). Any
# provider auth (3-D Secure / OTP / CAPTCHA) is handed to you in the provider's
# own secure flow — never pasted into Volo.

# ── Data ─────────────────────────────────────────────────────────────────────
# Where the local SQLite database lives. Relative to project root.
VOLO_DB_PATH=./.data/volo.db

# NOTE: NEVER put a paid API key in this file or commit real secrets.
# Any future paid integrations must be opt-in and clearly isolated.

GOOGLE_CLIENT_ID=